APP_NAME="TradeFlow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Baku

APP_LOCALE=az
APP_FALLBACK_LOCALE=az
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL / MariaDB (utf8mb4). Hostinger: hPanel -> Databases -> MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=glaust
DB_USERNAME=glaust
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Platform mailer: fallback when a company has no own SMTP (also password reset mails).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Glaust
GLAUST_REGISTRATION_OPEN=false
# Runs the scheduler from web traffic when no cron has been seen for 3 minutes (shared hosting safety net).
GLAUST_WEB_SCHEDULER=true
# Platform owner (super admin), created by `php artisan db:seed` if set.
GLAUST_ADMIN_EMAIL=
GLAUST_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
